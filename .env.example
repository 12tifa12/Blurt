# Copy this file to .env and fill in ONE of the keys below.
# .env is ignored by git, so the key never ends up in your repository.

# Claude (paid, cheap with the default Haiku model): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: a different Claude model
CLAUDE_MODEL=

# Free for trying it yourself: Google Gemini's free tier, used only when ANTHROPIC_API_KEY is empty.
# Get a key at https://aistudio.google.com/apikey. Google may use free-tier prompts to
# improve its products, so don't use a free key with other people's data.
GEMINI_API_KEY=
# Optional: another model, e.g. gemini-3.5-flash-lite or gemini-3.8-flash
GEMINI_MODEL=

# Who may use AI sorting on a hosted server, one code per tester, separated by commas.
# Each tester opens https://your-site/?code=THEIR_CODE once. Use codes that are hard to guess.
# Anyone else gets the built-in sorter. Your own computer needs no code.
INVITE_CODES=
# Optional: limits that protect your bill (defaults shown)
SORTS_PER_INVITE_PER_DAY=30
SORTS_PER_DAY=300
