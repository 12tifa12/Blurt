# Copy this file to .env and fill in ONE of the keys below.
# .env is ignored by git, so the key never ends up in your repository.

# Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Free for testing: Google Gemini's free tier, used only when ANTHROPIC_API_KEY is empty.
# Get a key at https://aistudio.google.com/apikey. Google may use free-tier prompts to
# improve its products, so don't use it for other people's data.
GEMINI_API_KEY=
# Optional: another free model, e.g. gemini-3.5-flash-lite or gemini-3.8-flash
GEMINI_MODEL=
